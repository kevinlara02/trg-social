# =====================================================================
# TRG Digital / Social Monitor  .  environment variables
# These are the ones the code ACTUALLY reads. Set them in Netlify:
# Site settings > Environment variables.
# =====================================================================

# ---- Frontend (Vite build) ----
# OPTIONAL. Login falls back to the TRG-OS Supabase project when these are
# unset, so you usually do NOT need to set them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server (Netlify function) variables ----

# Meta (Facebook + Instagram): ONE JSON object holding the 7 Page access tokens
# and account ids. Powers posts, comments, Messenger DMs and publishing.
META_CREDENTIALS_JSON=

# Yelp Fusion API key (ratings + review counts; review text is not available).
YELP_API_KEY=

# Anthropic Claude (the "Suggest with AI" reply drafting). If unset, the app
# still drafts with a local bilingual template.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# Google service account JSON. ONE key, used for BOTH GA4 website traffic and
# the Squarespace contact-form messages (read from Google Sheets).
GOOGLE_SA_JSON=

# Trusted token for scheduled jobs and server-to-server calls. Signed-in users
# authenticate with their TRG-OS session instead of this token.
SOCIAL_PROXY_TOKEN=
